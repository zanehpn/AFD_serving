+def summarize_attention_workload(
+    spans: list[AFDRequestTokenSpan], stage_idx: int,
+) -> dict[str, int | str] | None:
+    """Summarize exact real-token context work without reading GPU tensors.
+
+    Causal query/key pairs are a logical work feature, not HBM traffic. A GPU
+    may use MLA, sliding windows or linear attention; the fitted response must
+    remain model-specific. Missing spans mean unknown, never zero KV work.
+    """
+    selected = [span for span in spans if span.stage_idx == stage_idx]
+    if not selected:
+        return None
+    prefill = decode = prefill_context = decode_context = 0
+    request_ends: dict[str, int] = {}
+    occupied: list[tuple[int, int]] = []
+    for span in selected:
+        count, position = span.token_count, span.first_token_position
+        if count <= 0 or position < 0:
+            raise ValueError("invalid causal span in Attention workload")
+        occupied.append((span.token_offset, span.token_offset + count))
+        p = min(count, max(span.prompt_tokens - position, 0))
+        d = count - p
+        prefill += p
+        decode += d
+        prefill_context += p * (position + 1) + p * (p - 1) // 2
+        decode_context += d * (position + p + 1) + d * (d - 1) // 2
+        request_ends[span.request_id] = max(request_ends.get(span.request_id, 0), position + count)
+    occupied.sort()
+    if any(left[1] > right[0] for left, right in zip(occupied, occupied[1:])):
+        raise ValueError("overlapping real-token spans in Attention workload")
+    return {"schema_version": 1, "source": "request_token_spans",
+            "active_requests": len(request_ends),
+            "kv_sequence_tokens": sum(request_ends.values()),
+            "prefill_tokens": prefill, "decode_tokens": decode,
+            "prefill_context_tokens": prefill_context,
+            "decode_context_tokens": decode_context}

