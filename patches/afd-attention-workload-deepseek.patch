diff --git a/tests/unit/test_attention_workload_trace.py b/tests/unit/test_attention_workload_trace.py
new file mode 100644
index 0000000..33bcbb3
--- /dev/null
+++ b/tests/unit/test_attention_workload_trace.py
@@ -0,0 +1,80 @@
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from afd_plugin.connectors.metadata import AFDRequestTokenSpan
+from afd_plugin.observability import StageTracer, summarize_attention_workload
+from afd_plugin.v1.worker.ubatch_wrapper import slice_request_token_spans
+
+
+def span(request, offset, count, position, prompt, stage=0):
+    return AFDRequestTokenSpan(request_id=request, token_offset=offset, token_count=count,
+                               first_token_position=position, prompt_tokens=prompt,
+                               phase="mixed", stage_idx=stage)
+
+
+def test_context_summary_counts_causal_work_and_excludes_other_microbatch():
+    spans = [span("p", 0, 3, 4, 6), span("d", 3, 1, 100, 10), span("other", 0, 1, 9000, 10, 1)]
+    row = summarize_attention_workload(spans, 0)
+    assert row["prefill_tokens"] == 2
+    assert row["decode_tokens"] == 2
+    assert row["prefill_context_tokens"] == 5 + 6
+    assert row["decode_context_tokens"] == 7 + 101
+    assert row["kv_sequence_tokens"] == 7 + 101
+    assert row["active_requests"] == 2
+
+
+def test_missing_spans_are_unknown_not_zero_context():
+    assert summarize_attention_workload([], 0) is None
+    assert summarize_attention_workload([span("other", 0, 1, 9000, 10, 1)], 0) is None
+
+
+def test_real_spans_exclude_padded_transport_tokens():
+    row = summarize_attention_workload([span("real", 0, 1, 40, 10)], 0)
+    assert row["active_requests"] == 1
+    assert row["decode_tokens"] == 1
+    assert row["decode_context_tokens"] == 41
+
+
+def test_context_summary_preserves_chunked_prefill_after_ubatch_slicing():
+    original = [span("r", 0, 6, 4, 8)]
+    left = slice_request_token_spans(original, 0, 3, stage_idx=0)
+    right = slice_request_token_spans(original, 3, 6, stage_idx=1)
+    a, b = summarize_attention_workload(left, 0), summarize_attention_workload(right, 1)
+    assert a["prefill_context_tokens"] == 5 + 6 + 7
+    assert b["prefill_context_tokens"] == 8
+    assert b["decode_context_tokens"] == 9 + 10
+
+
+def test_duplicate_overlapping_spans_fail():
+    with pytest.raises(ValueError, match="overlapping"):
+        summarize_attention_workload([span("a", 0, 2, 20, 10), span("b", 1, 2, 30, 10)], 0)
+
+
+def test_trace_writes_real_context_and_timing_source(tmp_path, monkeypatch):
+    path = tmp_path / "trace.jsonl"
+    monkeypatch.setenv("ECODEP_STAGE_TRACE", str(path))
+    monkeypatch.setenv("ECODEP_TRACE_CUDA_EVENTS", "0")
+    monkeypatch.delenv("ECODEP_TRACE_SYNC_CUDA", raising=False)
+    tracer = StageTracer(role="attention", rank=0)
+    with tracer.record("attention_compute", transaction_id="real", stage_idx=0,
+                       tokens=16, prefill_tokens=0, decode_tokens=1,
+                       request_token_spans=[span("r", 0, 1, 1023, 100)]):
+        pass
+    row = json.loads(path.read_text())
+    assert row["attention_workload"]["decode_context_tokens"] == 1024
+    assert row["attention_workload"]["decode_tokens"] == 1
+    assert row["tokens"] == 16
+    assert row["timing_source"] == "host"
+
+
+def test_disabled_tracer_does_not_process_context(monkeypatch):
+    monkeypatch.delenv("ECODEP_STAGE_TRACE", raising=False)
+    monkeypatch.delenv("ECODEP_EXPERT_EPOCH_TRACE", raising=False)
+    tracer = StageTracer(role="attention", rank=0)
+    # Invalid duplicate spans would raise if the disabled path processed them.
+    spans = [span("a", 0, 2, 20, 10), span("b", 1, 2, 30, 10)]
+    with tracer.record("attention_compute", request_token_spans=spans):
+        pass
