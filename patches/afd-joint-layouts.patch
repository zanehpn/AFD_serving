--- /dev/null
+++ b/afd_plugin/runtime_layout.py
@@ -0,0 +1,48 @@
+"""Validate joint BO's layout against worker state after model construction."""
+import json
+import os
+from pathlib import Path
+
+
+def record_worker_layout(vllm_config, model, role, role_rank):
+    raw = os.environ.get('ECODEP_EXPECTED_LAYOUT')
+    if not raw:
+        return
+    expected = json.loads(raw)
+    parallel = vllm_config.parallel_config
+    expert = role == 'ffn'
+    key = 'expert' if expert else 'attention'
+    tp = expected[key + '_tp']
+    dp = expected['expert_native_dp' if expert else 'attention_dp']
+    m = expected['microbatches']
+    actual_m = int(parallel.num_ubatches) if parallel.use_ubatching else 1
+    actual = {'native_tp': int(parallel.tensor_parallel_size),
+              'native_dp': int(parallel.data_parallel_size),
+              'enable_expert_parallel': bool(parallel.enable_expert_parallel),
+              'microbatches': actual_m,
+              'dbo_decode_token_threshold': int(parallel.dbo_decode_token_threshold),
+              'dbo_prefill_token_threshold': int(parallel.dbo_prefill_token_threshold)}
+    wanted = {'native_tp': tp, 'native_dp': dp,
+              'enable_expert_parallel': expected['expert_enable_ep'] if expert else False,
+              'microbatches': m,
+              'dbo_decode_token_threshold': expected['dbo_decode_token_threshold'],
+              'dbo_prefill_token_threshold': expected['dbo_prefill_token_threshold']}
+    if actual != wanted:
+        raise RuntimeError(f'Worker layout differs from joint candidate: {actual} != {wanted}')
+    shards = []
+    if expert:
+        for module in model.modules():
+            config = getattr(module, 'moe_config', None)
+            if config is None:
+                continue
+            mapping = config.moe_parallel_config
+            shards.append({'tp': int(mapping.tp_size), 'ep': int(mapping.ep_size)})
+        wanted_shard = {'tp': tp, 'ep': dp if expected['expert_enable_ep'] else 1}
+        if not shards or any(item != wanted_shard for item in shards):
+            raise RuntimeError(f'Actual MoE shards differ from candidate: {shards} != {wanted_shard}')
+    rank = role_rank + expected[key + '_rank_offset']
+    result = {'role': role, 'rank': rank, 'local_role_rank': role_rank,
+              'replica': expected['replica'], 'actual': actual,
+              'expert_shards': shards, 'verified': True}
+    path = Path(expected['directory']) / f'worker-layout-{role}-{rank}.json'
+    path.write_text(json.dumps(result, indent=2) + '\n')
