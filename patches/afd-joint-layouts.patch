@@ -0,0 +1,67 @@
+"""CPU verification of actual MoE shard receipts, independent of vLLM import."""
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace as NS
+import pytest
+from dataclasses import dataclass
+import sys
+
+spec = importlib.util.spec_from_file_location('joint_runtime_layout', Path(__file__).resolve().parents[2]/'afd_plugin/runtime_layout.py')
+runtime = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(runtime)
+
+
+@pytest.mark.parametrize('tp,ep,m', [(2,1,4),(1,2,1),(1,1,2)])
+def test_actual_shards_and_microbatch_are_required(tmp_path, monkeypatch, tp, ep, m):
+    expected = dict(expert_tp=tp, expert_native_dp=ep, expert_enable_ep=ep>1,
+                    expert_rank_offset=2, replica=1, microbatches=m, directory=str(tmp_path),
+                    dbo_decode_token_threshold=2, dbo_prefill_token_threshold=12)
+    monkeypatch.setenv('ECODEP_EXPECTED_LAYOUT',json.dumps(expected))
+    pc=NS(tensor_parallel_size=tp,data_parallel_size=ep,enable_expert_parallel=ep>1,
+          use_ubatching=m>1,num_ubatches=m,
+          dbo_decode_token_threshold=2,dbo_prefill_token_threshold=12)
+    shard=NS(tp_size=tp,ep_size=ep)
+    model=NS(modules=lambda:[NS(moe_config=NS(moe_parallel_config=shard))])
+    runtime.record_worker_layout(NS(parallel_config=pc),model,'ffn',0)
+    receipt=json.loads((tmp_path/'worker-layout-ffn-2.json').read_text())
+    assert receipt['actual']['microbatches']==m and receipt['replica']==1
+    pc.dbo_prefill_token_threshold=512
+    with pytest.raises(RuntimeError,match='Worker layout'):
+        runtime.record_worker_layout(NS(parallel_config=pc),model,'ffn',0)
+    pc.dbo_prefill_token_threshold=12
+    shard.tp_size=tp+1
+    with pytest.raises(RuntimeError,match='MoE shards'):
+        runtime.record_worker_layout(NS(parallel_config=pc),model,'ffn',0)
+    pc.tensor_parallel_size=tp+1
+    with pytest.raises(RuntimeError,match='Worker layout'):
+        runtime.record_worker_layout(NS(parallel_config=pc),model,'ffn',0)
+
+
+def test_peer_composition_expands_tp_metadata(monkeypatch):
+    # Only the annotation dependency is stubbed; execute the real merge code.
+    monkeypatch.setitem(sys.modules, 'afd_plugin.connectors.metadata', NS(AFDControlPayload=object))
+    path=Path(__file__).resolve().parents[2]/'afd_plugin/connectors/gpu/composition.py'
+    spec=importlib.util.spec_from_file_location('joint_composition',path)
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    @dataclass
+    class Span:
+        stage_idx:int=0
+        token_offset:int=0
+        token_count:int=5
+        phase:str='decode'
+    @dataclass
+    class Payload:
+        source_rank:int
+        dp_metadata_list:dict
+        request_token_spans:list
+        transaction_id:str='transaction'
+        is_warmup:bool=False
+        is_graph_capturing:bool=False
+        phase:str='decode'
+    metadata={0:NS(num_tokens_across_dp_cpu=NS(tolist=lambda:[3,5]),max_tokens_across_dp_cpu=5)}
+    a,b=(Payload(i,metadata,[Span()]) for i in (2,3))
+    result=module.merge_peer_payloads([a,b],[2,3],4)
+    assert [s.token_offset for s in result.request_token_spans]==[0,5]
+    with pytest.raises(ValueError,match='cannot map'):
+        module.merge_peer_payloads([a,b],[2,3],3)
