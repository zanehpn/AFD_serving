+++ b/afd_plugin/connectors/gpu/composition.py
@@ -0,0 +1,41 @@
+"""Merge actual peer control messages for a concatenated Expert microbatch."""
+from dataclasses import replace
+from afd_plugin.connectors.metadata import AFDControlPayload
+
+
+def merge_peer_payloads(payloads, expected_sources):
+    if not payloads or len(payloads) != len(expected_sources):
+        raise ValueError("Missing Attention control payload")
+    if [p.source_rank for p in payloads] != list(expected_sources):
+        raise ValueError("Attention control source/order mismatch")
+    first = payloads[0]
+    offsets = {stage: 0 for stage in first.dp_metadata_list}
+    spans = []
+    for payload in payloads:
+        if (payload.transaction_id != first.transaction_id
+                or payload.is_warmup != first.is_warmup
+                or payload.is_graph_capturing != first.is_graph_capturing
+                or payload.dp_metadata_list.keys() != first.dp_metadata_list.keys()):
+            raise ValueError("Attention peers disagree on transaction or stages")
+        for stage, metadata in payload.dp_metadata_list.items():
+            counts = metadata.num_tokens_across_dp_cpu.tolist()
+            reference = first.dp_metadata_list[stage]
+            if (counts != reference.num_tokens_across_dp_cpu.tolist()
+                    or int(metadata.max_tokens_across_dp_cpu) != int(reference.max_tokens_across_dp_cpu)):
+                raise ValueError("Attention peers disagree on DP token counts")
+            if not 0 <= payload.source_rank < len(counts):
+                raise ValueError("Control source has no DP token count")
+            width = max(1, int(counts[payload.source_rank]))
+            stage_spans = [s for s in payload.request_token_spans if s.stage_idx == stage]
+            end = 0
+            for span in sorted(stage_spans, key=lambda s: s.token_offset):
+                if span.token_offset < end or span.token_offset + span.token_count > width:
+                    raise ValueError("Request spans overlap or exceed peer wire tensor")
+                end = span.token_offset + span.token_count
+                spans.append(replace(span, token_offset=span.token_offset + offsets[stage]))
+            offsets[stage] += width
+        if any(s.stage_idx not in offsets for s in payload.request_token_spans):
+            raise ValueError("Request span has unknown microbatch stage")
+    phases = {s.phase for s in spans}
+    phase = next(iter(phases)) if len(phases) == 1 else ("mixed" if phases else "unknown")
+    return replace(first, phase=phase, request_token_spans=spans)
