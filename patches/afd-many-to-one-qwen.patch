index 0000000..437b10e
--- /dev/null
+++ b/tests/unit/connectors/test_many_to_one_composition.py
@@ -0,0 +1,46 @@
+from dataclasses import replace
+import pytest
+from afd_plugin.connectors.metadata import AFDControlPayload, AFDDPMetadata, AFDRequestTokenSpan, encode_control_payload, decode_control_payload
+from afd_plugin.connectors.gpu.composition import merge_peer_payloads
+
+
+def payload(rank, tx='afd-7', counts=(3, 5), spans=None):
+    return AFDControlPayload(dp_metadata_list={0: AFDDPMetadata(list(counts)), 1: AFDDPMetadata([1, 2])},
+        is_graph_capturing=False, is_warmup=False, source_rank=rank, transaction_id=tx, phase='mixed', request_token_spans=spans or [])
+
+
+def span(request, count, stage=0, phase='prefill'):
+    return AFDRequestTokenSpan(request, 0, count, 0, 10, phase, stage_idx=stage)
+
+
+def test_wire_roundtrip_merges_real_peer_composition_in_concatenation_order():
+    a=payload(0,spans=[span('a',3),span('a-dec',1,1,'decode')])
+    b=payload(1,spans=[span('b',5),span('b-dec',2,1,'decode')])
+    wire=[decode_control_payload(encode_control_payload(p)) for p in (a,b)]
+    merged=merge_peer_payloads(wire,[0,1])
+    assert merged.transaction_id=='afd-7'
+    assert merged.phase=='mixed'
+    assert [(s.request_id,s.stage_idx,s.token_offset,s.token_count) for s in merged.request_token_spans]==[
+        ('a',0,0,3),('a-dec',1,0,1),('b',0,3,5),('b-dec',1,1,2)]
+    assert b.request_token_spans[0].token_offset==0
+
+
+def test_idle_peer_padding_offsets_are_not_counted_as_requests():
+    a=payload(0,counts=(0,5))
+    b=payload(1,counts=(0,5),spans=[span('b',5)])
+    merged=merge_peer_payloads([a,b],[0,1])
+    assert [(s.token_offset,s.token_count) for s in merged.request_token_spans]==[(1,5)]
+
+
+@pytest.mark.parametrize('kind',['transaction','source','counts','stages','warmup','missing','overflow','overlap'])
+def test_mismatched_or_ambiguous_composition_fails_closed(kind):
+    a,b=payload(0),payload(1,spans=[span('b',5)])
+    if kind=='transaction': b.transaction_id='afd-8'
+    if kind=='source': b.source_rank=0
+    if kind=='counts': b.dp_metadata_list[0]=AFDDPMetadata([3,6])
+    if kind=='stages': b.dp_metadata_list.pop(1)
+    if kind=='warmup': b.is_warmup=True
+    if kind=='overflow': b.request_token_spans=[span('b',6)]
+    if kind=='overlap': b.request_token_spans=[span('b',5),span('c',1)]
+    with pytest.raises(ValueError):
+        merge_peer_payloads([a] if kind=='missing' else [a,b],[0,1])
