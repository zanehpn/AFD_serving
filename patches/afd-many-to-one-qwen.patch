+def test_2a1e_second_attention_sends_and_expert_receives_both_peers(monkeypatch):
+    module = importlib.import_module('afd_plugin.connectors.gpu.p2p')
+    def connector(role, rank):
+        return module.P2pNcclAFDConnector(rank, 0,
+            _fake_vllm_config(data_parallel_size=2 if role=='attention' else 1, data_parallel_rank=rank),
+            AFDConfig(role=role,connector='P2pNcclAFDConnector',num_attention_ranks=2,num_ffn_ranks=1),
+            role_rank=rank)
+    a1=connector('attention',1)
+    assert a1.p2p_rank==2
+    a1.p2p_pg=object()
+    payloads=[AFDControlPayload(dp_metadata_list={0:AFDDPMetadata([3,5])},
+        is_graph_capturing=False,is_warmup=False,source_rank=i,transaction_id='afd-7') for i in range(2)]
+    sent=[]
+    monkeypatch.setattr(module,'send_control_payload',lambda payload,**kwargs:sent.append((payload,kwargs)))
+    a1.control_plane.send_dp_metadata_list(payloads[1])
+    assert sent[0][0] is payloads[1]
+    assert sent[0][1]['dst']==[0]
+    expert=connector('ffn',0)
+    expert.p2p_pg=object()
+    received=[]
+    def receive(**kwargs):
+        received.append(kwargs['src'])
+        return payloads[kwargs['src']-1]
+    monkeypatch.setattr(module,'recv_control_payload',receive)
+    merged=expert.control_plane.recv_dp_metadata_list()
+    assert received==[1,2]
+    assert merged.transaction_id=='afd-7'

