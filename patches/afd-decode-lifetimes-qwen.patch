diff --git a/tests/unit/test_attention_workload_trace.py b/tests/unit/test_attention_workload_trace.py
index 33bcbb3..746227a 100644
--- a/tests/unit/test_attention_workload_trace.py
+++ b/tests/unit/test_attention_workload_trace.py
@@ -78,3 +78,28 @@ def test_disabled_tracer_does_not_process_context(monkeypatch):
     spans = [span("a", 0, 2, 20, 10), span("b", 1, 2, 30, 10)]
     with tracer.record("attention_compute", request_token_spans=spans):
         pass
+
+
+def test_decode_lifetime_spans_are_opt_in_and_exclude_prefill():
+    spans = [span("r", 0, 4, 8, 10)]
+    assert summarize_attention_workload(spans, 0)["decode_request_spans"] == []
+    result = summarize_attention_workload(spans, 0, include_decode_spans=True)
+    assert result["decode_request_spans"] == [{"request_id": "r", "prompt_tokens": 10,
+                                              "first_token_position": 10, "token_count": 2}]
+
+
+def test_tracer_emits_lifetime_detail_only_at_first_layer(tmp_path, monkeypatch):
+    path = tmp_path / "trace.jsonl"
+    monkeypatch.setenv("ECODEP_STAGE_TRACE", str(path))
+    monkeypatch.setenv("ECODEP_TRACE_CUDA_EVENTS", "0")
+    monkeypatch.delenv("ECODEP_TRACE_SYNC_CUDA", raising=False)
+    tracer = StageTracer(role="attention", rank=0)
+    for layer in (0, 1):
+        with tracer.record("attention_compute", transaction_id="real", stage_idx=0, layer_idx=layer,
+                           tokens=1, prefill_tokens=0, decode_tokens=1,
+                           request_token_spans=[span("r", 0, 1, 10, 10)]):
+            pass
+    first, second = [json.loads(line) for line in path.read_text().splitlines()]
+    assert first["decode_request_spans"][0]["first_token_position"] == 10
+    assert second["decode_request_spans"] == []
+    assert first["attention_workload"] == second["attention_workload"]
